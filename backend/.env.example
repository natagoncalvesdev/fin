# Copie para .env e ajuste os valores:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)

# Chave secreta para tokens JWT — gere uma string longa e aleatória em produção
SECRET_KEY=altere-esta-chave-secreta-em-producao

# PostgreSQL
# Local (sem Docker):
DATABASE_URL=postgresql://fin:fin@localhost:5432/fin
# Docker Compose (dentro do container api, use host "db"):
# DATABASE_URL=postgresql://fin:fin@db:5432/fin

# Origens permitidas no CORS (separadas por vírgula, sem espaços extras)
# Inclua seu domínio em produção:
CORS_ORIGINS=https://fin.natdev.com.br,http://localhost:8000,http://127.0.0.1:8000

# Validade do token de login em minutos (padrão: 7 dias = 10080)
ACCESS_TOKEN_EXPIRE_MINUTES=10080
